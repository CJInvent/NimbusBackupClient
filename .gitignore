# Build artifacts
dist/
!gui/frontend/dist/
node_modules/
build/

# Binaries
proxmoxbackupgo_cli.exe
proxmoxbackupgo.exe
proxmox-backup-gui
proxmox-backup-gui.exe
proxmox-backup-gui-*
*.exe
*.dll
*.so
*.dylib

# Config (keep examples)
config.json
!config.json.example
*.ini
!*.example.ini

# Test coverage
*.out
coverage.txt

# Go workspace
.go/
vendor/

# Pinned dev tooling fetched by scripts/local-gates.sh (golangci-lint at the
# version CI uses). Downloaded, never committed: a binary in the tree is a
# second, silently-drifting pin.
.tools/

# Generated Windows version resource (created in CI by goversioninfo)
*.syso
gui/versioninfo.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Packages
*.tar.gz
*.zip
*.AppImage

# Logs
*.log
# Idées/notes locales (pas dans git)
GEMINI_IDEAS.md

# `go build ./...` inside gui/ leaves a bare `gui` binary next to the sources.
# Untracked and easy to stage by accident with `git add -A`, which is how a
# 20 MB Linux ELF ends up in a Windows client's history.
/gui/gui
/gui/gui.exe
